# Copy to .env and fill in. Every value has a safe default for local dev
# except where noted -- see README.md's "What's real vs scaffolded" table.

# Postgres in anything resembling production; sqlite (the default in
# app/config.py) needs nothing set here at all.
DATABASE_URL=postgresql+psycopg://app_write_role:CHANGE_ME@localhost:5432/servicing
APP_WRITE_ROLE=app_write_role

# Stage 2 NLU classifier (§4.1). Without this, FakeLLMClassifier is used
# instead -- safe (fails toward clarify/escalate, never a wrong
# auto-approval) but under-resolves ambiguous traffic. Get a free-trial
# key at https://platform.claude.com (Settings -> API keys) -- new
# accounts get a small free credit, no cost to try this. Haiku 4.5 is the
# cheapest current model and plenty for a classification task like this
# one -- stretches free credit much further than the Sonnet default.
# Verify current model names/pricing at https://docs.claude.com before
# deploying anything real, they change.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Fault injection for the mock backends (§8.5) -- leave at 0 unless
# you're deliberately exercising resilience paths locally.
FAULT_RATE=0
LATENCY_MS=0
